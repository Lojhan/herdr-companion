{
  "name": "herdr-companion",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:bridge": "tsx watch apps/bridge/src/cli.ts serve",
    "companion": "tsx apps/bridge/src/cli.ts",
    "dev:mobile": "pnpm --filter @companion/mobile start",
    "dev:web": "pnpm --filter @companion/mobile web",
    "generate:core": "tsx scripts/generate-core.ts",
    "check:generated": "tsx scripts/generate-core.ts --check",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @companion/mobile lint",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build:web": "pnpm --filter @companion/mobile build:web",
    "build:bridge": "tsx scripts/build-bridge.ts",
    "doctor": "pnpm --filter @companion/mobile run doctor",
    "dev:sandbox": "tsx scripts/dev-sandbox.ts",
    "bundle:terminal": "tsx scripts/bundle-terminal.ts",
    "test:e2e:web": "playwright test",
    "format": "prettier --write apps/*/src packages/*/src scripts tests *.ts *.json docs/*.md README.md --ignore-path .prettierignore",
    "install:core": "tsx scripts/install-test-core.ts",
    "test:ui": "playwright test --config playwright.audit.config.ts",
    "test:ui:native": "tsx scripts/test-native.ts",
    "test:ui:codex": "tsx scripts/test-codex.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "esbuild": "0.28.2",
    "expo-doctor": "1.21.5",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.0"
  },
  "type": "module"
}
